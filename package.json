{
  "name": "flowpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Личный планировщик дел для macOS",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "test:electron-abi": "electron-rebuild -f -w better-sqlite3 && ELECTRON_RUN_AS_NODE=1 electron scripts/storage-abi-check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/renderer/**/*.css\" --ignore-pattern src/renderer/styles/tokens.css",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run stylelint && npm run depcruise && npm run test",
    "e2e": "FLOWPILOT_E2E=1 electron-forge package && FLOWPILOT_E2E=1 TZ=UTC playwright test",
    "package": "electron-forge package --arch=arm64 --platform=darwin",
    "make": "electron-forge make --arch=arm64 --platform=darwin"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ajv": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.5.0",
    "electron": "^44.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
